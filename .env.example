# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Required for AI-powered tools (rewrite, imagery, metaphors, ideas)
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5.4-mini

# ── Rate limiting ───────────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=30

# ── Logging ─────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
