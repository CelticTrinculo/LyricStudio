{
  "name": "lyric-studio",
  "version": "0.2.0",
  "description": "A creative writing workspace for poetry and song lyrics.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.js",
    "start": "bun src/server.js",
    "lint": "eslint 'src/**/*.js' 'public/js/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' 'public/js/**/*.js' --fix",
    "format": "prettier --write 'src/**/*.js' 'public/**/*.{js,css,html}'"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "openai": "^6.35.0",
    "pino": "^9.10.0",
    "pino-pretty": "^13.1.1"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "prettier": "^3.5.3"
  }
}
